      "parameters": {
        "jsCode": "// 🛡️ ANTI-DUPLICADO — Bloquea ejecuciones repetidas del mismo mensaje\nconst messageId = $input.item.json.body?.data?.key?.id || '';\nconst fromMe = $input.item.json.body?.data?.key?.fromMe;\nconst event = $input.item.json.body?.event || '';\n\n// 1. Filtrar mensajes propios del bot\nif (fromMe === true) {\n  return [];\n}\n\n// 2. Filtrar eventos que no sean mensajes nuevos\nif (event !== 'messages.upsert') {\n  return [];\n}\n\n// 3. Filtrar si no hay message_id\nif (!messageId) {\n  return [];\n}\n\n// 4. Deduplicación usando variable global en memoria de n8n\n// Usamos $execution.id para tener contexto de ejecución\nconst cacheKey = 'processed_msg_' + messageId;\n\n// Revisar si ya procesamos este message_id en los últimos 30 segundos\nconst ahora = Date.now();\nconst ventana = 30000; // 30 segundos\n\n// Acceder al store global de n8n (workflow static data)\nconst staticData = $getWorkflowStaticData('global');\n\nif (!staticData.mensajesProcesados) {\n  staticData.mensajesProcesados = {};\n}\n\n// Limpiar mensajes viejos (más de 60 segundos)\nfor (const id in staticData.mensajesProcesados) {\n  if (ahora - staticData.mensajesProcesados[id] > 60000) {\n    delete staticData.mensajesProcesados[id];\n  }\n}\n\n// Si ya procesamos este mensaje recientemente → bloquear\nif (staticData.mensajesProcesados[messageId] && \n    ahora - staticData.mensajesProcesados[messageId] < ventana) {\n  console.log('DUPLICADO BLOQUEADO: ' + messageId);\n  return []; // Detiene la ejecución\n}\n\n// Marcar como procesado\nstaticData.mensajesProcesados[messageId] = ahora;\n\n// Continuar con el flujo normal\nreturn [$input.item];"
