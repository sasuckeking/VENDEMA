    {
      "parameters": {
        "jsCode": "// Process Context v3\n// - Detecta respuestas a ESTADOS de WhatsApp\n// - Entiende citas de cualquier tipo: texto, video, foto, audio, documento, sticker, ubicación, contacto\n// - Identifica quién escribió el mensaje citado (cliente o tienda)\ntry {\n  const webhookData = $('Webhook').first()?.json;\n  const body = webhookData?.body;\n  const data = body?.data || {};\n  const message = data.message || {};\n\n  const inputData = $input.item.json;\n  const processedContent = inputData?.chat_input || '';\n\n  // ---------- Números (para saber quién escribió el mensaje citado) ----------\n  const soloNum = s => String(s || '').replace(/@.*$/, '').replace(/\\D/g, '');\n  const botNum = soloNum(body?.sender);\n  const clienteNums = [data.key?.remoteJid, data.key?.remoteJidAlt]\n    .filter(Boolean)\n    .map(soloNum);\n\n  // ---------- contextInfo: aquí WhatsApp guarda la cita ----------\n  const ctxs = [\n    message?.extendedTextMessage?.contextInfo,\n    message?.imageMessage?.contextInfo,\n    message?.videoMessage?.contextInfo,\n    message?.audioMessage?.contextInfo,\n    message?.documentMessage?.contextInfo,\n    message?.stickerMessage?.contextInfo,\n    data?.contextInfo\n  ].filter(Boolean);\n\n  const ctx = ctxs.find(c => c.quotedMessage || c.remoteJid === 'status@broadcast') || {};\n  const esEstado = ctx.remoteJid === 'status@broadcast';\n  const qmRaw = ctx.quotedMessage || null;\n\n  // ---------- Describir el mensaje citado ----------\n  function desenvolver(q) {\n    return q?.ephemeralMessage?.message\n        || q?.viewOnceMessage?.message\n        || q?.viewOnceMessageV2?.message\n        || q?.documentWithCaptionMessage?.message\n        || q;\n  }\n\n  function describirCitado(q0) {\n    const q = desenvolver(q0);\n    if (!q) return { tipo: '', texto: '' };\n    if (q.conversation) return { tipo: 'texto', texto: q.conversation };\n    if (q.extendedTextMessage?.text) return { tipo: 'texto', texto: q.extendedTextMessage.text };\n    if (q.imageMessage) return { tipo: 'FOTO', texto: q.imageMessage.caption || '' };\n    if (q.videoMessage) return { tipo: 'VIDEO', texto: q.videoMessage.caption || '' };\n    if (q.audioMessage) return { tipo: 'AUDIO', texto: '' };\n    if (q.documentMessage) return { tipo: 'DOCUMENTO', texto: q.documentMessage.caption || q.documentMessage.fileName || '' };\n    if (q.stickerMessage) return { tipo: 'STICKER', texto: '' };\n    if (q.locationMessage) return { tipo: 'UBICACIÓN', texto: '' };\n    if (q.contactMessage) return { tipo: 'CONTACTO', texto: q.contactMessage.displayName || '' };\n    return { tipo: 'MENSAJE', texto: '' };\n  }\n\n  const citado = describirCitado(qmRaw);\n  const hayCita = Boolean(qmRaw) && !esEstado;\n  const citaEsTexto = citado.tipo === 'texto';\n  const citaMultimedia = hayCita && !citaEsTexto;\n\n  // ---------- Autor de la cita ----------\n  const partNum = soloNum(ctx.participant);\n  let autor = 'desconocido';\n  if (partNum && partNum === botNum) autor = 'tienda';\n  else if (partNum && clienteNums.includes(partNum)) autor = 'cliente';\n\n  const quien = autor === 'cliente' ? 'que el mismo cliente envió antes'\n              : autor === 'tienda'  ? 'que la tienda le envió antes'\n              : 'enviado antes en la conversación';\n\n  // ---------- Estado de WhatsApp ----------\n  const captionEstado = esEstado\n    ? (qmRaw?.imageMessage?.caption || qmRaw?.videoMessage?.caption || qmRaw?.conversation || qmRaw?.extendedTextMessage?.text || '')\n    : '';\n\n  const messageType = message?.extendedTextMessage ? 'text' :\n                      message?.conversation ? 'text' :\n                      message?.audioMessage ? 'audio' :\n                      message?.imageMessage ? 'image' :\n                      message?.videoMessage ? 'video' :\n                      'unknown';\n\n  // ---------- Armar mensajes finales ----------\n  let finalMessage = processedContent || '';\n  let clasificadorInput = processedContent;\n  let notaCita = '';\n\n  if (esEstado) {\n    const nota = captionEstado\n      ? `[El cliente respondió a un ESTADO de WhatsApp de la tienda que dice: \"${captionEstado}\"]`\n      : `[El cliente respondió a un ESTADO de WhatsApp de la tienda. No se puede ver su contenido]`;\n    clasificadorInput = `${nota} ${processedContent}`;\n    finalMessage = `${nota}\\n\\n${processedContent}`;\n\n  } else if (hayCita && citaEsTexto && citado.texto) {\n    // Cita de texto: se mantiene el comportamiento original\n    notaCita = `[El cliente respondió citando un mensaje ${quien}: \"${citado.texto}\"]`;\n    finalMessage = `[🔴 CONTEXTO IMPORTANTE: El usuario está respondiendo/citando un mensaje anterior]\\n\\nMENSAJE ANTERIOR CITADO:\\n\"${citado.texto}\"\\n\\nRESPUESTA DEL USUARIO ACTUAL:\\n${processedContent}\\n\\n[INSTRUCCIÓN: Lee el MENSAJE CITADO con atención. Si el usuario hace referencia a números (1, 2, 3, etc.) o dice \"esto\", \"eso\", \"la primera\", etc., se refiere a elementos del MENSAJE CITADO. No necesitas usar tools para entender esa referencia: la información está en el mensaje citado.]`;\n    // clasificadorInput se deja igual (solo el mensaje actual), como antes\n\n  } else if (citaMultimedia) {\n    // Cita de video/foto/audio/documento: el bot no lo puede ver, pero debe saberlo\n    const detalle = citado.texto ? ` (texto asociado: \"${citado.texto}\")` : '';\n    notaCita = `[El cliente respondió citando un ${citado.tipo} ${quien}${detalle}. El bot NO puede ver ni escuchar ese ${citado.tipo}.]`;\n    clasificadorInput = `${notaCita} ${processedContent}`;\n    finalMessage = `${notaCita}\\n\\nMENSAJE ACTUAL DEL CLIENTE:\\n${processedContent}\\n\\n[INSTRUCCIÓN: El cliente se refiere a ese ${citado.tipo} que no puedes ver. NO le preguntes qué producto quiere ni le pidas que repita todo. Dile que recibiste su ${citado.tipo} y que un miembro del equipo lo revisará y lo contactará en breve.]`;\n  }\n\n  return {\n    json: {\n      chat_input: finalMessage,\n      quoted_message_content: citado.texto || (citaMultimedia ? `[${citado.tipo}]` : ''),\n      has_quoted_message: hayCita,\n      quoted_participant: ctx.participant || '',\n      message_content: processedContent,\n      message_type: messageType,\n      session_id: data?.key?.remoteJid || '',\n      user_name: data?.pushName || '',\n      es_respuesta_estado: esEstado,\n      caption_estado: captionEstado,\n      cita_tipo: hayCita ? citado.tipo : '',\n      cita_autor: hayCita ? autor : '',\n      cita_multimedia: citaMultimedia,\n      clasificador_input: clasificadorInput,\n      _debug: {\n        original_content: processedContent,\n        estado_detectado: esEstado,\n        cita_detectada: hayCita,\n        cita_tipo: citado.tipo,\n        cita_autor: autor,\n        participant_crudo: ctx.participant || '',\n        bot_num: botNum,\n        cliente_nums: clienteNums,\n        final_message_length: finalMessage ? finalMessage.length : 0\n      }\n    }\n  };\n\n} catch (error) {\n  const fallback = $input.item.json?.chat_input || '';\n  return {\n    json: {\n      chat_input: fallback || 'Error procesando mensaje',\n      quoted_message_content: '',\n      has_quoted_message: false,\n      quoted_participant: '',\n      message_content: fallback,\n      message_type: 'unknown',\n      session_id: '',\n      user_name: '',\n      es_respuesta_estado: false,\n      caption_estado: '',\n      cita_tipo: '',\n      cita_autor: '',\n      cita_multimedia: false,\n      clasificador_input: fallback,\n      _error: error.message\n    }\n  };\n}"
