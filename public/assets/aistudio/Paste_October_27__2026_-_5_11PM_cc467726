        "jsCode": "const input = $input.item.json;\nconst userMessage = input.mensaje_usuario || '';\nconst assistantMessage = input.mensaje_asistente || '';\nconst sessionId = input.session_id || '';\nconst userNumber = input.user_number || '';\nconst userName = input.user_name || '';\nconst textoCompleto = (userMessage + ' ' + assistantMessage).toLowerCase();\nconst patronesNoInteresado = ['no me interesa','no quiero','no gracias','ya no','muy caro','no tengo dinero','no me llama','cambié de opinión','ya compré en otro lado','no me gusta','no lo necesito','ya no lo quiero'];\nconst esNoInteresado = patronesNoInteresado.some(p => textoCompleto.includes(p));\nconst patronesFecha = [/el (\\d+)/i,/en (\\d+) d[ií]as?/i,/la pr[óo]xima semana/i,/cuando cobre/i,/cuando me paguen/i,/puede ser el/i,/lo har[ée] el/i,/te estaré contactando el/i,/te contactaré el/i];\nconst detectoFecha = patronesFecha.some(p => p.test(textoCompleto));\nlet fechaProgramada = null;\nif (detectoFecha) {\n  const ahora = new Date();\n  const matchDia = textoCompleto.match(/el (\\d+)/);\n  if (matchDia) { const dia = parseInt(matchDia[1]); fechaProgramada = new Date(ahora.getFullYear(), ahora.getMonth(), dia, 10, 0, 0); if (fechaProgramada < ahora) fechaProgramada.setMonth(fechaProgramada.getMonth() + 1); }\n  const matchDias = textoCompleto.match(/en (\\d+) d[ií]as?/);\n  if (matchDias) { fechaProgramada = new Date(ahora); fechaProgramada.setDate(fechaProgramada.getDate() + parseInt(matchDias[1])); fechaProgramada.setHours(10, 0, 0, 0); }\n  if (/la pr[óo]xima semana/i.test(textoCompleto)) { fechaProgramada = new Date(ahora); fechaProgramada.setDate(fechaProgramada.getDate() + 7); fechaProgramada.setHours(10, 0, 0, 0); }\n  if (/cuando cobre|cuando me paguen/i.test(textoCompleto)) { fechaProgramada = new Date(ahora.getFullYear(), ahora.getMonth() + 1, 0, 10, 0, 0); }\n}\nconst patronesCompra = ['ya compré','ya lo compré','ya pagué','ya transferí','ya compre','ya lo compre','ya pague','ya transferi','lo compre','lo compré'];\nconst compraRealizada = patronesCompra.some(p => textoCompleto.includes(p));\nreturn [{ json: { mensaje_asistente: assistantMessage, session_id: sessionId, user_number: userNumber, user_name: userName, es_no_interesado: esNoInteresado, detecto_fecha: detectoFecha, fecha_programada: fechaProgramada ? fechaProgramada.toISOString() : null, compra_realizada: compraRealizada, debe_ejecutar_supabase: esNoInteresado || detectoFecha || compraRealizada } }];"
