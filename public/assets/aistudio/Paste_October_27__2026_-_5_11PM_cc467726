              "value": "={{ (() => {\n  try {\n    const p = JSON.parse(($json.content || '').replace(/```json|```/g, '').trim());\n    if (p.es_comprobante) return 'COMPROBANTE_PAGO';\n    if (p.tipo === 'vacante') return 'El cliente envió captura de un anuncio de EMPLEO / VACANTE: ' + p.descripcion;\n    if (p.tipo === 'otro') return 'El cliente envió una imagen que no es producto ni comprobante: ' + p.descripcion;\n    return 'El cliente envió una imagen de: ' + p.descripcion + '. Búscalo en el INVENTARIO (sugerencia: ' + p.query_busqueda + ')';\n  } catch (e) {\n    return $json.content;\n  }\n})() }}",
