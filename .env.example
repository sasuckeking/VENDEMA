# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional API key when OpenAI (GPT-4o / GPT-4o-mini) is selected as AI provider.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# DEEPSEEK_API_KEY: Optional API key when DeepSeek (deepseek-chat / deepseek-reasoner) is selected as AI provider.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: Credentials for Supabase PostgreSQL database & Realtime sync
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# ODOO ERP: Credentials for Todo Lapto inventory & quotation sync
ODOO_URL="https://todolapto.com.do/jsonrpc"
ODOO_DB="odoo"
ODOO_UID="22"
ODOO_API_KEY="MY_ODOO_API_KEY"

# EVOLUTION API: WhatsApp gateway credentials
EVOLUTION_SERVER_URL="https://evolution-evolution-api.blrfh6.easypanel.host"
EVOLUTION_INSTANCE="todolapto"
EVOLUTION_API_KEY="MY_EVOLUTION_API_KEY"
EVOLUTION_TEAM_PHONE="18492588738"
EVOLUTION_ADMIN_PHONE="18496260800"

